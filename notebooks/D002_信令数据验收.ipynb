    "# 验证可编辑安装：__file__ 必须指向你自己项目里的 src/signal_insight/\n",
    "import signal_insight\n",
    "from pathlib import Path\n",
    "print(signal_insight.__version__, signal_insight.__file__)\n",
    "assert Path(signal_insight.__file__).parent.parent.name == \"src\", \"装到别处去了：见《可编辑安装》第 10 节\"\n",
    "print(\"✅ 可编辑安装成功\")"
