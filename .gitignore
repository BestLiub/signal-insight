# 数据一律不进仓库
data/
*.db
*.sqlite
*.sqlite3

# 凭据一律不进仓库：.env.ps1 里有数据库密码
.env.ps1
.env

# CSV 默认也不进：防止把导出的明细表误提交
*.csv
# 例外：文档里的口径表、测试用的小样例可以进
!docs/*.csv
!tests/**/*.csv
# 产物：随时可以由代码重新生成
image/
reports/

# Python 和 Jupyter 的缓存
__pycache__/
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.virtual_documents/

# 编辑器和系统文件
.idea/
.vscode/
.DS_Store